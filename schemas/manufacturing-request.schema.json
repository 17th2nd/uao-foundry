{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://17th2nd.github.io/uao-foundry/schemas/manufacturing-request.schema.json",
  "title": "UAO Foundry Manufacturing Request",
  "description": "Foundry-owned input contract. Only identitySeed is required; absent constraints remain absent or receive explicit execution defaults.",
  "type": "object",
  "required": ["identitySeed"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "requestId": {"type": "string", "pattern": "^req-[a-f0-9]{16}$"},
    "identitySeed": {"type": "string", "minLength": 1},
    "inputLanguage": {"type": ["string", "null"], "minLength": 1},
    "scopeHint": {"type": ["string", "null"], "minLength": 1},
    "jurisdictionHint": {"type": ["string", "null"], "minLength": 1},
    "timeScope": {"type": ["string", "null"], "minLength": 1},
    "manufacturingProfile": {"type": ["string", "null"], "minLength": 1},
    "executionMode": {"type": ["string", "null"], "enum": ["fixture", "live", null]},
    "requestedVersion": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"}
  },
  "additionalProperties": false
}
