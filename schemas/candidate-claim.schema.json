{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAO Foundry Candidate Claim",
  "type": "object",
  "required": ["candidateId", "subjectIdentityRef", "statement", "sourceRefs"],
  "properties": {
    "candidateId": {"type": "string", "pattern": "^clm-[a-z0-9._-]+$"},
    "subjectIdentityRef": {"type": "string", "pattern": "^cid-[a-z0-9._-]+$"},
    "statement": {"type": "string", "minLength": 1},
    "channels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src-[a-z0-9._-]+$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
