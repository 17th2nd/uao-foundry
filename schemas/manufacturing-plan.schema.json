{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAO Foundry Manufacturing Plan",
  "type": "object",
  "required": ["planVersion", "selectedIdentity", "dimensions", "neighbouringIdentities", "anticipatedSourceClasses", "risks", "completionQuestions", "exclusions"],
  "properties": {
    "planVersion": {"type": "string", "const": "0.1.0"},
    "selectedIdentity": {"type": "string", "minLength": 1},
    "dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "neighbouringIdentities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "anticipatedSourceClasses": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "risks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "completionQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["questionId", "prompt", "required"],
        "properties": {
          "questionId": {"type": "string", "pattern": "^q-[a-z0-9._-]+$"},
          "prompt": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
