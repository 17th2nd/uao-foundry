{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAO Foundry Interpretation Candidates",
  "type": "object",
  "required": ["seed", "interpretations", "provider"],
  "properties": {
    "seed": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidateId", "label", "definition", "semanticTypeProposal", "confidence", "status"],
        "properties": {
          "candidateId": {"type": "string", "pattern": "^int-[a-z0-9._-]+$"},
          "label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "semanticTypeProposal": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"type": "string", "enum": ["PROPOSED", "SELECTED", "EXCLUDED", "UNRESOLVED"]},
          "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
