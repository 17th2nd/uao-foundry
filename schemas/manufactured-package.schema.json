{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAO Manufactured Package",
  "type": "object",
  "required": ["packageVersion", "request", "rootUaoId", "uaos", "uros", "verification", "publicationDecision"],
  "properties": {
    "packageVersion": {"type": "string", "const": "0.1.0"},
    "request": {"$ref": "manufacturing-request.schema.json"},
    "rootUaoId": {"type": "string", "pattern": "^uao-[a-f0-9]{12}$"},
    "uaos": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-uao.schema.json"}},
    "uros": {"type": "array", "items": {"$ref": "canonical-uro.schema.json"}},
    "verification": {"$ref": "verification-report.schema.json"},
    "publicationDecision": {"$ref": "publication-decision.schema.json"}
  },
  "additionalProperties": false
}
